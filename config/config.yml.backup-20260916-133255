refresh_seconds: 5
ssh:
  connect_timeout: 3
  key_file: /root/.ssh/id_ed25519
  known_hosts_file: /root/.ssh/known_hosts

notifications:
  node_down:
    enabled: true
    failures_before_alert: 3
    recovery_mail: true
    
nodes:
  - name: Pi-01-6
    host: 192.168.178.6
    user: root
  - name: Pi-02-8
    host: 192.168.178.8
    user: root
  - name: Pi-03-5
    host: 192.168.178.5
    user: root

vrrp:
  - name: DNS
    vip: 192.168.178.11
    nodes: [Pi-01-6, Pi-02-8, Pi-03-5]
  - name: Caddy
    vip: 192.168.178.12
    nodes: [Pi-01-6, Pi-02-8]
  - name: Vaultwarden
    vip: 192.168.178.14
    nodes: [Pi-01-6, Pi-02-8]
