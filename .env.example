# Keepalived Monitor - example environment configuration
# Copy this file to .env and replace the example values.
# NEVER commit the real .env file.

# Web login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Flask session secret
# Generate e.g. with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-secret

# Set to true when the application is served exclusively via HTTPS.
COOKIE_SECURE=false

# E-mail notifications
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=monitor@example.com
SMTP_PASSWORD=change-me
MAIL_FROM=monitor@example.com
MAIL_TO=admin@example.com
